[sub_resource type="GDScript" id="GDScript_5tk0l"]
resource_name = "rigid body"
script/source = "extends RigidBody2D


var in_air = true

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	linear_velocity = Vector2(300, 0)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	if Input.is_action_just_pressed(\"jump\") and not  in_air:
		linear_velocity.y = -400

	var direction := Input.get_axis(\"it_left\", \"right\")
	if direction:
		linear_velocity.x = direction * 400
	else:
		linear_velocity.x = move_toward(linear_velocity.x, 0, 400)
		


func _on_area_2d_body_shape_entered(body_rid: RID, body: Node2D, body_shape_index: int, local_shape_index: int) -> void:
	in_air = false

func _on_area_2d_body_shape_exited(body_rid: RID, body: Node2D, body_shape_index: int, local_shape_index: int) -> void:
	in_air = true

func _on_body_entered(body: Node) -> void:
	if body is TileMapLayer:
		print (body.name)
		if body.name == \"TileMapLayer2\":
			call_deferred(\"apply_central_impulse\", Vector2(-5000, 0))
"

